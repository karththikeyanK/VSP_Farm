<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="80dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <!-- Section: Report Permissions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cashier Permissions"
            android:textStyle="bold"
            android:textSize="24sp"
            android:paddingBottom="8dp"/>

        <!-- Section: Report Permissions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Report Permissions"
            android:textStyle="bold"
            android:textSize="18sp"
            android:paddingBottom="8dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:padding="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardUseCompatPadding="true">
            <Switch
                android:id="@+id/todaySummaryReportSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:padding="4dp"
                android:text="Today Summary Report Permission" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:padding="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardUseCompatPadding="true">
        <Switch
            android:id="@+id/todayDetailReportSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:padding="4dp"
            android:text="Today Detail Report Permission" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:padding="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardUseCompatPadding="true">
        <Switch
            android:id="@+id/getSummaryReportSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:padding="4dp"
            android:text="Get Summary Report Permission" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:padding="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardUseCompatPadding="true">
        <Switch
            android:id="@+id/getDetailReportSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:padding="4dp"
            android:text="Get Detail Report Permission" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:padding="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardUseCompatPadding="true">
        <Switch
            android:id="@+id/getCustomerReportSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:padding="4dp"
            android:text="Get Customer Report Permission" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:padding="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardUseCompatPadding="true">
            <Switch
                android:id="@+id/viewLoanPaymentsSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:padding="4dp"
                android:text="View Loan Payments" />
        </androidx.cardview.widget.CardView>

        <!-- Section: Customer Permissions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Customer Permissions"
            android:textStyle="bold"
            android:textSize="18sp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"/>


        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:padding="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardUseCompatPadding="true">
            <Switch
                android:id="@+id/addCustomerSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:padding="4dp"
                android:text="Add Customer Permission" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:padding="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardUseCompatPadding="true">
        <Switch
            android:id="@+id/editCustomerSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:padding="4dp"
            android:text="Edit Customer Permission" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Item Permissions"
            android:textStyle="bold"
            android:textSize="18sp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:padding="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardUseCompatPadding="true">
        <Switch
            android:id="@+id/addItemSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:padding="4dp"
            android:text="Add Item Permission" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:padding="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardUseCompatPadding="true">
        <Switch
            android:id="@+id/editItemSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:padding="4dp"
            android:text="Edit Item Permission" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:padding="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardUseCompatPadding="true">
        <Switch
            android:id="@+id/addSubItemSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:text="Add Sub-Item Permission" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:padding="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardUseCompatPadding="true">
        <Switch
            android:id="@+id/editSubItemSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:padding="4dp"
            android:text="Edit Sub-Item Permission" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:padding="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardUseCompatPadding="true">
        <Switch
            android:id="@+id/disableEnableItemSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:padding="4dp"
            android:text="Disable/Enable Item Permission" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
